# inglenook — a Fedora-based bootc OS image.
#
# Base: the earliest bootc-capable layer of the Fedora image "cake":
# fedora-bootc is the bootc-ified fedora-minimal (kernel, ostree, bootc
# tooling — no desktop/GUI). The layers above it (fedora, fedora-toolbox,
# fedora-workstation) add progressively more, up to a full GUI at the top.
ARG FEDORA_VERSION=45
FROM registry.fedoraproject.org/fedora-bootc:${FEDORA_VERSION} AS pre

# OCI well-known image labels (image-spec annotations.md). VERSION/REVISION
# are passed by build.sh via --build-arg; the defaults keep ad-hoc
# `buildah build -f` invocations valid. org.opencontainers.image.created is
# set automatically by buildah/podman, and base.digest is intentionally not
# set (it changes with every base rebuild, so a static value would go stale).
ARG FEDORA_VERSION
ARG VERSION=latest
ARG REVISION=unknown

LABEL org.opencontainers.image.title="inglenook" \
      org.opencontainers.image.description="A Fedora-based bootc operating system image" \
      org.opencontainers.image.authors="Joakim Nohlgård" \
      org.opencontainers.image.vendor="Snugmo" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.url="https://github.com/snugmo/inglenook" \
      org.opencontainers.image.documentation="https://github.com/snugmo/inglenook" \
      org.opencontainers.image.source="https://github.com/snugmo/inglenook.git" \
      org.opencontainers.image.ref.name="inglenook" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="registry.fedoraproject.org/fedora-bootc:${FEDORA_VERSION}"

# Base image fixups, so the boot journal is clean on a read-only root:
# tmpfiles.d (rpm-ostree-0-integration.conf) wants /usr/local/sbin, which the
# base lacks, and root.conf's `z / 555` tries to fchmod the composefs root,
# whose mode a container build cannot change (it stays 0755), so drop the rule.
RUN mkdir -p /usr/local/sbin \
 && sed -i '/^z \/ 555 /d' /usr/lib/tmpfiles.d/root.conf

# Packages, in two layers (core first, tools after it) with one commented line
# per group, sorted by name within the group. podman, skopeo and openssh-clients
# are already in the base; they are listed so the image states its intent
# (container dev environment, ssh and hardware keys). pcsc-lite is for
# smartcard/PIV YubiKeys (pcscd.socket is preset-enabled), opensc provides the
# PKCS#11 module ssh uses with PIV. pam-u2f (with pamu2fcfg to register a key)
# is the PAM module for FIDO2 keys on plain accounts; homed's own FIDO2 support
# needs no package. systemd-boot-unsigned is the loader bootc
# installs (--bootloader systemd). chrony, systemd-resolved, systemd-sysusers and
# systemd-udev are in the base already and listed for intent; systemd-networkd
# and systemd-oomd-defaults (the oomd policy defaults) are new.
RUN dnf -y install \
      # containers and source control
      buildah git-core podman skopeo \
      # ssh and hardware keys
      opensc openssh-clients pam-u2f pamu2fcfg pcsc-lite pcsc-lite-ccid yubico-piv-tool yubikey-manager \
      # boot, audit and name resolution
      audit efibootmgr nss-mdns systemd-boot-unsigned \
      # time, networking and other systemd components
      chrony systemd-networkd systemd-oomd-defaults systemd-resolved systemd-sysusers systemd-udev wireguard-tools \
 && dnf clean all

# General-purpose command-line tools. acl, attr, bind-utils, bubblewrap,
# ca-certificates, gawk, gnupg2 and gpgme are in the base already and listed for
# intent. The base also has util-linux, e2fsprogs, xfsprogs, btrfs-progs,
# cryptsetup (veritysetup), lvm2, nvme-cli, openssl, jq, curl, 7zip and the
# basics (sed, findutils, diffutils, procps-ng, iproute, iputils, socat, file,
# less, nano, xz, zstd, bzip2, gzip, unzip). wget2-wget provides /usr/bin/wget.
# yama-ptrace-enable (a weak dependency of strace) is excluded: it turns off the
# kernel's ptrace_scope hardening.
RUN dnf -y install --exclude=yama-ptrace-enable \
      # shells, editors and terminal multiplexers
      fish tmux vim-enhanced xxd zsh \
      # source control (the full git on top of git-core, for the extra tools)
      git \
      # text and file utilities
      acl attr bat gawk patch ripgrep tree which \
      # data and archives
      lz4 sqlite xxhash yq zip zlib-ng \
      # debugging and sandboxing
      bubblewrap setools-console strace time \
      # network and file transfer
      bind-utils knot-utils nmap nmap-ncat rsync tcpdump wget2-wget \
      # certificates and encryption
      ca-certificates gnupg2 gpgme \
 && dnf clean all

# Packages the base ships that this image does not use. There is no GRUB (the
# loader is systemd-boot from a UKI, bootc installs it itself), so grub2, shim
# (only grub2-efi-x64 needs it) and bootupd (the GRUB/shim updater) go, with
# grub2-set-bootflag's setuid bit. sudo goes too: run0 replaces it and the image
# has no setuid sudo. dnf protects these through config files, which are
# removed first.
RUN rm -f /etc/dnf/protected.d/{grub2-efi-x64,grub2-pc,grub2-tools-minimal,shim,sudo}.conf \
          /usr/share/dnf5/libdnf.conf.d/protect-sudo.conf \
 && dnf -y remove bootupd grub2-common grub2-efi-x64 grub2-pc grub2-pc-modules \
      grub2-tools grub2-tools-minimal os-prober shim-x64 sudo \
 && dnf clean all

# No setuid binaries. run0 (polkit) replaces sudo, su and pkexec; with
# polkit-agent-helper.socket enabled the password agent talks to a
# socket-activated helper, so the setuid helper binary is unused. mount and
# umount are only used by root; unix_chkpwd, passwd and friends are for local
# password changes by non-root users, which homed users do with homectl. File
# capabilities (newuidmap, newgidmap, arping) are not setuid and stay; setgid
# files are left as they are. smoke.sh fails on any setuid file.
RUN find /usr -xdev -type f -perm -4000 -exec chmod u-s {} + \
 && systemctl enable polkit-agent-helper.socket systemd-homed-firstboot.service

# The base image's bootc-generic-growpart.service grows the root partition to the end of the
# disk, but only in a VM and only for a plain partition (not LUKS). The installer chooses the
# layout (a fixed root, the rest for /var), so a VM must not behave differently from hardware.
RUN systemctl mask bootc-generic-growpart.service

# Static files that belong in the image as they are (units, ...): see rootfs/.
COPY rootfs/ /

# systemd uses DEFAULT_HOSTNAME from os-release when /etc/hostname is absent, so
# a wiped /etc still gets a sensible name; avahi advertises it as <name>.local
# and the login banner (rootfs/usr/lib/issue.d) shows it with the IP addresses.
RUN sed -i 's/^DEFAULT_HOSTNAME=.*/DEFAULT_HOSTNAME="inglenook"/' /usr/lib/os-release

# Account & access. No regular account and no ssh key are baked into the image: root
# is locked, and the first user is a systemd-homed account that the installer asks
# for and creates on the first boot from a credential (docs/installer.md). SSH host
# keys are generated on first sshd run. (Tests and the persistent stick log in through
# credentials passed to the VM or the stick's ESP, never through a key in the image.)

# PAM: put pam_systemd_home into the authselect profile (the features the base
# image selected stay), so homed users can log in on the console, with run0 and
# over ssh. This is /etc (authselect links /etc/pam.d), carried by the factory
# copy below. pam-u2f is installed but its feature (with-pam-u2f) stays off:
# turning it on makes every plain account need a key mapping.
# with-group-merging makes the nsswitch group line `files [SUCCESS=merge]
# altfiles [SUCCESS=merge] systemd`: glibc otherwise stops at the first source
# that knows a group, and wheel exists (empty) in /etc/group and /usr/lib/group,
# so the members that homed publishes through nss-systemd were never seen
# (getent group wheel was empty, polkit found no administrators). Use the
# feature, not an edit of the generated file: authselect regenerates it.
RUN authselect select $(authselect current --raw) with-systemd-homed with-group-merging --force \
 && grep -q '^group:.*SUCCESS=merge' /etc/authselect/nsswitch.conf

# Local SELinux policy. The CIL modules in rootfs/usr/share/inglenook/selinux
# are installed into the policy store (/etc/selinux, so the factory copy below
# carries them). SELINUX_NO_DONTAUDIT=1 (the default while the policy is being
# worked out) rebuilds the policy without dontaudit rules, so that `ausearch -m
# avc` shows every denial, including the ones the stock policy hides; the
# process-transition noise (siginh, rlimitinh, noatsecure) comes with it.
# -n: do not try to load the policy into the build host's kernel.
ARG SELINUX_NO_DONTAUDIT=1
RUN semodule -n -i /usr/share/inglenook/selinux/*.cil \
 && if [ "$SELINUX_NO_DONTAUDIT" = 1 ]; then semodule -n -DB; fi

# Factory /etc. This must be the last thing that touches /etc in this stage.
# The image must boot with /etc wiped, so a snapshot of the finished /etc goes
# to /usr/share/factory/etc and tmpfiles.d restores each top-level entry that
# is missing (`C` copies from there when the destination does not exist; `!`
# limits it to boot time). passwd and group are restored too: system accounts
# live in /usr/lib/{passwd,group} (nss-altfiles), and accounts can only join
# wheel if wheel is also in /etc/group. shadow and gshadow are not: the
# SELinux policy forbids systemd-tmpfiles to stat them (an error on every boot
# with a rule for them), and sysusers recreates what it needs. The `-` backup
# copies, per-machine files and credstore*, which systemd manages itself, are
# left out too.
# /etc/selinux is among the restored entries, so the policy comes back too. The
# generated rule file is derived from the snapshot, so it cannot drift.
RUN rm -rf /usr/share/factory/etc \
 && mkdir -p /usr/share/factory \
 && cp -a /etc /usr/share/factory/etc \
 && cd /usr/share/factory/etc \
 && rm -f passwd- group- shadow shadow- gshadow gshadow- \
          machine-id hostname resolv.conf mtab \
 && rm -rf credstore credstore.encrypted \
 && { echo '# Generated at image build time from /usr/share/factory/etc.'; \
      for e in $(ls -A); do printf 'C! /etc/%s - - - -\n' "$e"; done; } \
      > /usr/lib/tmpfiles.d/inglenook-etc-factory.conf

# UEFI boot: bootc installs systemd-boot (--bootloader systemd) and boots a
# UKI; there is no GRUB. The loader comes from systemd-boot-unsigned (above).

# Initrd stage. dracut is not used: build.sh builds the initrd with mkosi
# (images/initrd) from this `pre` stage's kernel modules and bootc binary, and
# passes it in as the named build context `initrd`. It replaces the stock
# initramfs and is part of the rootfs the UKI's composefs digest covers, so it
# must land here, before the digest is computed. The mkosi initrd already
# carries the virtio and vsock drivers, so no dracut drop-in is needed.
FROM pre AS base
RUN --mount=type=bind,from=initrd,target=/initrd \
    set -e; set -- /usr/lib/modules/*; test $# -eq 1 \
 && install -m0644 /initrd/initrd.cpio.zst "$1/initramfs.img"

# UKI stage. The UKI's command line carries composefs=<digest> of the
# *finished* base rootfs, which is computed by build.sh from the stored
# layers of the `base` target (`bootc container compute-composefs-digest-
# from-storage`) and passed in as COMPOSEFS_DIGEST. `bootc container ukify`
# is deliberately not used: it measures a mounted rootfs, whose directory
# mtimes are the layer-extraction time and so never match the digest bootc
# computes at install time. /boot is excluded from the digest, so adding the
# UKI to the final image does not invalidate it. ukify stays out of the image.
# The leading "?" makes fs-verity optional (build.sh builds for VM testing).
FROM base AS uki
ARG COMPOSEFS_DIGEST
# rw: the composefs root and the /var, /etc binds from /sysroot inherit its
# mount flags, and nothing else remounts /sysroot read-write.
ARG KARGS="rw console=tty0 console=ttyS0,115200n8 inglenook.var=xfs"
# The initrd's own systemd sets the hostname from *its* os-release before the
# real root starts, so DEFAULT_HOSTNAME in the image's os-release is not enough;
# a static /etc/hostname still overrides systemd.hostname=.
ARG DEFAULT_HOSTNAME=inglenook
# SELinux mode on the kernel command line: 0 = permissive (denials are logged
# but not enforced, which gives a complete list in one boot while the policy is
# worked out), 1 = enforcing. The policy's own config says enforcing.
ARG SELINUX_ENFORCING=0
RUN test -n "$COMPOSEFS_DIGEST" || { echo "COMPOSEFS_DIGEST not set; build with images/build.sh" >&2; exit 1; }
RUN dnf -y install systemd-ukify && dnf clean all
RUN kver=$(ls /usr/lib/modules) \
 && mkdir -p /out \
 && ukify build \
      --linux "/usr/lib/modules/$kver/vmlinuz" \
      --initrd "/usr/lib/modules/$kver/initramfs.img" \
      --uname "$kver" \
      --os-release @/usr/lib/os-release \
      --cmdline "$KARGS enforcing=$SELINUX_ENFORCING systemd.hostname=$DEFAULT_HOSTNAME composefs=?$COMPOSEFS_DIGEST" \
      --output /out/inglenook.efi

# Final stage: must stay last and bootc-based (see AGENTS.md).
FROM base
COPY --from=uki /out/inglenook.efi /boot/EFI/Linux/inglenook.efi
