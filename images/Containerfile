# inglenook — a Fedora-based bootc OS image.
#
# Base: the earliest bootc-capable layer of the Fedora image "cake":
# fedora-bootc is the bootc-ified fedora-minimal (kernel, ostree, bootc
# tooling — no desktop/GUI). The layers above it (fedora, fedora-toolbox,
# fedora-workstation) add progressively more, up to a full GUI at the top.
ARG FEDORA_VERSION=45
FROM registry.fedoraproject.org/fedora-bootc:${FEDORA_VERSION} AS base

# OCI well-known image labels (image-spec annotations.md). VERSION/REVISION
# are passed by build.sh via --build-arg; the defaults keep ad-hoc
# `buildah build -f` invocations valid. org.opencontainers.image.created is
# set automatically by buildah/podman, and base.digest is intentionally not
# set (it changes with every base rebuild, so a static value would go stale).
ARG FEDORA_VERSION
ARG VERSION=latest
ARG REVISION=unknown

LABEL org.opencontainers.image.title="inglenook" \
      org.opencontainers.image.description="A Fedora-based bootc operating system image" \
      org.opencontainers.image.authors="Joakim Nohlgård" \
      org.opencontainers.image.vendor="Snugmo" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.url="https://github.com/snugmo/inglenook" \
      org.opencontainers.image.documentation="https://github.com/snugmo/inglenook" \
      org.opencontainers.image.source="https://github.com/snugmo/inglenook.git" \
      org.opencontainers.image.ref.name="inglenook" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="registry.fedoraproject.org/fedora-bootc:${FEDORA_VERSION}"

# Account & access. Default login account (UID 1000, shared with the cote
# workspace images), declared with sysusers.d so systemd-sysusers re-creates it
# at boot if /etc was wiped (no useradd at build time; /etc/passwd is not part
# of the image's contract). A plain passwd entry is deliberate: a userdb
# drop-in record was not visible to setuid sudo. The agent pubkey is baked in
# at build time via --build-arg SSH_PUBKEY=… into a root-owned file under /usr;
# tmpfiles.d symlinks it as ~/.ssh/authorized_keys. That path is the one place
# both the regular sshd and the per-connection sshd that systemd-ssh-generator
# starts for ssh-over-vsock read (the latter overrides AuthorizedKeysFile to
# only a hypervisor credential plus ~/.ssh/authorized_keys), so no sshd config
# is needed. SSH host keys are generated on first sshd run.
ARG SSH_PUBKEY=
RUN mkdir -p /usr/lib/ssh/authorized_keys \
 && printf 'g user 1000\nu user 1000:user "user" /var/home/user /bin/bash\nm user wheel\n' > /usr/lib/sysusers.d/inglenook-user.conf \
 && printf '%s\n' "$SSH_PUBKEY" > /usr/lib/ssh/authorized_keys/user \
 && chmod 0644 /usr/lib/ssh/authorized_keys/user \
 && printf 'd /var/home/user 0700 user user -\nd /var/home/user/.ssh 0700 user user -\nL+ /var/home/user/.ssh/authorized_keys - - - - /usr/lib/ssh/authorized_keys/user\n' > /usr/lib/tmpfiles.d/inglenook-user.conf

# Boot configuration. Ensure every regenerated initramfs carries the
# virtio-vsock stack so ssh-over-vsock works with no IP in the guest.
# (add_drivers is the dracut>=0.60 name for the old kmods directive.)
# No serial-getty enablement is needed: systemd-getty-generator links a
# serial-getty for each console= on the kernel command line (set in the UKI).
RUN mkdir -p /etc/dracut.conf.d \
 && printf 'add_drivers+=" vmw_vsock_virtio_transport virtio_net "\n' > /etc/dracut.conf.d/99-vsock.conf

# UEFI boot. bootc installs systemd-boot (--bootloader systemd) and boots a
# UKI; there is no GRUB. systemd-boot-unsigned provides the loader binary
# bootc copies to the ESP.
RUN dnf -y install systemd-boot-unsigned \
 && dnf clean all

# UKI stage. The UKI's command line carries composefs=<digest> of the
# *finished* base rootfs, which is computed by build.sh from the stored
# layers of the `base` target (`bootc container compute-composefs-digest-
# from-storage`) and passed in as COMPOSEFS_DIGEST. `bootc container ukify`
# is deliberately not used: it measures a mounted rootfs, whose directory
# mtimes are the layer-extraction time and so never match the digest bootc
# computes at install time. /boot is excluded from the digest, so adding the
# UKI to the final image does not invalidate it. ukify stays out of the image.
# The leading "?" makes fs-verity optional (build.sh builds for VM testing).
FROM base AS uki
ARG COMPOSEFS_DIGEST
# rw: the composefs root and the /var, /etc binds from /sysroot inherit its
# mount flags, and nothing else remounts /sysroot read-write.
ARG KARGS="rw console=tty0 console=ttyS0,115200n8"
RUN test -n "$COMPOSEFS_DIGEST" || { echo "COMPOSEFS_DIGEST not set; build with images/build.sh" >&2; exit 1; }
RUN dnf -y install systemd-ukify && dnf clean all
RUN kver=$(ls /usr/lib/modules) \
 && mkdir -p /out \
 && ukify build \
      --linux "/usr/lib/modules/$kver/vmlinuz" \
      --initrd "/usr/lib/modules/$kver/initramfs.img" \
      --uname "$kver" \
      --os-release @/usr/lib/os-release \
      --cmdline "$KARGS composefs=?$COMPOSEFS_DIGEST" \
      --output /out/inglenook.efi

# Final stage: must stay last and bootc-based (see AGENTS.md).
FROM base
COPY --from=uki /out/inglenook.efi /boot/EFI/Linux/inglenook.efi
