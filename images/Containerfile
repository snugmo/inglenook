# inglenook — a Fedora-based bootc OS image.
#
# Base: the earliest bootc-capable layer of the Fedora image "cake":
# fedora-bootc is the bootc-ified fedora-minimal (kernel, ostree, bootc
# tooling — no desktop/GUI). The layers above it (fedora, fedora-toolbox,
# fedora-workstation) add progressively more, up to a full GUI at the top.
ARG FEDORA_VERSION=45
FROM registry.fedoraproject.org/fedora-bootc:${FEDORA_VERSION} AS pre

# OCI well-known image labels (image-spec annotations.md). VERSION/REVISION
# are passed by build.sh via --build-arg; the defaults keep ad-hoc
# `buildah build -f` invocations valid. org.opencontainers.image.created is
# set automatically by buildah/podman, and base.digest is intentionally not
# set (it changes with every base rebuild, so a static value would go stale).
ARG FEDORA_VERSION
ARG VERSION=latest
ARG REVISION=unknown

LABEL org.opencontainers.image.title="inglenook" \
      org.opencontainers.image.description="A Fedora-based bootc operating system image" \
      org.opencontainers.image.authors="Joakim Nohlgård" \
      org.opencontainers.image.vendor="Snugmo" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.url="https://github.com/snugmo/inglenook" \
      org.opencontainers.image.documentation="https://github.com/snugmo/inglenook" \
      org.opencontainers.image.source="https://github.com/snugmo/inglenook.git" \
      org.opencontainers.image.ref.name="inglenook" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="registry.fedoraproject.org/fedora-bootc:${FEDORA_VERSION}"

# Base image fixups, so the boot journal is clean on a read-only root:
# tmpfiles.d (rpm-ostree-0-integration.conf) wants /usr/local/sbin, which the
# base lacks, and root.conf's `z / 555` tries to fchmod the composefs root,
# whose mode a container build cannot change (it stays 0755), so drop the rule.
RUN mkdir -p /usr/local/sbin \
 && sed -i '/^z \/ 555 /d' /usr/lib/tmpfiles.d/root.conf

# Packages. podman, skopeo and openssh-clients are already in the base; they are
# listed so the image states its intent (container dev environment, ssh and
# hardware keys). pcsc-lite is for smartcard/PIV YubiKeys (pcscd.socket is
# preset-enabled), opensc provides the PKCS#11 module ssh uses with PIV.
# systemd-boot-unsigned is the loader bootc installs (--bootloader systemd).
RUN dnf -y install \
      podman buildah skopeo git-core \
      openssh-clients yubikey-manager yubico-piv-tool pcsc-lite pcsc-lite-ccid opensc \
      nss-mdns \
      systemd-boot-unsigned \
 && dnf clean all

# Static files that belong in the image as they are (units, ...): see rootfs/.
COPY rootfs/ /

# systemd uses DEFAULT_HOSTNAME from os-release when /etc/hostname is absent, so
# a wiped /etc still gets a sensible name; avahi advertises it as <name>.local
# and the login banner (rootfs/usr/lib/issue.d) shows it with the IP addresses.
RUN sed -i 's/^DEFAULT_HOSTNAME=.*/DEFAULT_HOSTNAME="inglenook"/' /usr/lib/os-release

# Account & access. Default login account (UID 1000, shared with the cote
# workspace images), declared with sysusers.d so systemd-sysusers re-creates it
# at boot if /etc was wiped (no useradd at build time; /etc/passwd is not part
# of the image's contract; wheel is declared too, as its only definition is in
# the /etc/group that a wipe removes). A plain passwd entry is deliberate: a userdb
# drop-in record was not visible to setuid sudo. The agent pubkey is baked in
# at build time via --build-arg SSH_PUBKEY=… into a root-owned file under /usr;
# tmpfiles.d symlinks it as ~/.ssh/authorized_keys. That path is the one place
# both the regular sshd and the per-connection sshd that systemd-ssh-generator
# starts for ssh-over-vsock read (the latter overrides AuthorizedKeysFile to
# only a hypervisor credential plus ~/.ssh/authorized_keys), so no sshd config
# is needed. SSH host keys are generated on first sshd run.
ARG SSH_PUBKEY=
RUN mkdir -p /usr/lib/ssh/authorized_keys \
 && printf 'g wheel 10\ng user 1000\nu user 1000:user "user" /var/home/user /bin/bash\nm user wheel\n' > /usr/lib/sysusers.d/inglenook-user.conf \
 && printf '%s\n' "$SSH_PUBKEY" > /usr/lib/ssh/authorized_keys/user \
 && chmod 0644 /usr/lib/ssh/authorized_keys/user \
 && printf 'd /var/home/user 0700 user user -\nd /var/home/user/.ssh 0700 user user -\nL+ /var/home/user/.ssh/authorized_keys - - - - /usr/lib/ssh/authorized_keys/user\n' > /usr/lib/tmpfiles.d/inglenook-user.conf

# Rootless podman/buildah need subordinate id ranges for `user`; a sysusers.d
# account does not get any (useradd would add them). The ranges only need to
# exist, so they are plain /etc files seeded here and carried by the factory
# copy below.
RUN printf 'user:524288:65536\n' > /etc/subuid \
 && printf 'user:524288:65536\n' > /etc/subgid

# Factory /etc. This must be the last thing that touches /etc in this stage.
# The image must boot with /etc wiped, so a snapshot of the finished /etc goes
# to /usr/share/factory/etc and tmpfiles.d restores each top-level entry that
# is missing (`C` copies from there when the destination does not exist; `!`
# limits it to boot time). Account databases are left out on purpose: sysusers.d
# is their source of truth (see Account & access); so are per-machine files
# and credstore*, which systemd manages itself. /etc/selinux is among the
# restored entries, so the policy comes back too. The generated rule file is
# derived from the snapshot, so it cannot drift.
RUN rm -rf /usr/share/factory/etc \
 && mkdir -p /usr/share/factory \
 && cp -a /etc /usr/share/factory/etc \
 && cd /usr/share/factory/etc \
 && rm -f passwd passwd- shadow shadow- group group- gshadow gshadow- \
          machine-id hostname resolv.conf mtab \
 && rm -rf credstore credstore.encrypted \
 && { echo '# Generated at image build time from /usr/share/factory/etc.'; \
      for e in $(ls -A); do printf 'C! /etc/%s - - - -\n' "$e"; done; } \
      > /usr/lib/tmpfiles.d/inglenook-etc-factory.conf

# UEFI boot: bootc installs systemd-boot (--bootloader systemd) and boots a
# UKI; there is no GRUB. The loader comes from systemd-boot-unsigned (above).

# Initrd stage. dracut is not used: build.sh builds the initrd with mkosi
# (images/initrd) from this `pre` stage's kernel modules and bootc binary, and
# passes it in as the named build context `initrd`. It replaces the stock
# initramfs and is part of the rootfs the UKI's composefs digest covers, so it
# must land here, before the digest is computed. The mkosi initrd already
# carries the virtio and vsock drivers, so no dracut drop-in is needed.
FROM pre AS base
RUN --mount=type=bind,from=initrd,target=/initrd \
    set -e; set -- /usr/lib/modules/*; test $# -eq 1 \
 && install -m0644 /initrd/initrd.cpio.zst "$1/initramfs.img"

# UKI stage. The UKI's command line carries composefs=<digest> of the
# *finished* base rootfs, which is computed by build.sh from the stored
# layers of the `base` target (`bootc container compute-composefs-digest-
# from-storage`) and passed in as COMPOSEFS_DIGEST. `bootc container ukify`
# is deliberately not used: it measures a mounted rootfs, whose directory
# mtimes are the layer-extraction time and so never match the digest bootc
# computes at install time. /boot is excluded from the digest, so adding the
# UKI to the final image does not invalidate it. ukify stays out of the image.
# The leading "?" makes fs-verity optional (build.sh builds for VM testing).
FROM base AS uki
ARG COMPOSEFS_DIGEST
# rw: the composefs root and the /var, /etc binds from /sysroot inherit its
# mount flags, and nothing else remounts /sysroot read-write.
ARG KARGS="rw console=tty0 console=ttyS0,115200n8"
RUN test -n "$COMPOSEFS_DIGEST" || { echo "COMPOSEFS_DIGEST not set; build with images/build.sh" >&2; exit 1; }
RUN dnf -y install systemd-ukify && dnf clean all
RUN kver=$(ls /usr/lib/modules) \
 && mkdir -p /out \
 && ukify build \
      --linux "/usr/lib/modules/$kver/vmlinuz" \
      --initrd "/usr/lib/modules/$kver/initramfs.img" \
      --uname "$kver" \
      --os-release @/usr/lib/os-release \
      --cmdline "$KARGS composefs=?$COMPOSEFS_DIGEST" \
      --output /out/inglenook.efi

# Final stage: must stay last and bootc-based (see AGENTS.md).
FROM base
COPY --from=uki /out/inglenook.efi /boot/EFI/Linux/inglenook.efi
