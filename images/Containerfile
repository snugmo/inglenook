# inglenook — a Fedora-based bootc OS image.
#
# Base: the earliest bootc-capable layer of the Fedora image "cake":
# fedora-bootc is the bootc-ified fedora-minimal (kernel, ostree, bootc
# tooling — no desktop/GUI). The layers above it (fedora, fedora-toolbox,
# fedora-workstation) add progressively more, up to a full GUI at the top.
FROM registry.fedoraproject.org/fedora-bootc:46

# OCI well-known image labels (image-spec annotations.md). VERSION/REVISION
# are passed by build.sh via --build-arg; the defaults keep ad-hoc
# `buildah build -f` invocations valid. org.opencontainers.image.created is
# set automatically by buildah/podman, and base.digest is intentionally not
# set (it changes with every base rebuild, so a static value would go stale).
ARG VERSION=latest
ARG REVISION=unknown

LABEL org.opencontainers.image.title="inglenook" \
      org.opencontainers.image.description="A Fedora-based bootc operating system image" \
      org.opencontainers.image.authors="Joakim Nohlgård" \
      org.opencontainers.image.vendor="Snugmo" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.url="https://github.com/snugmo/inglenook" \
      org.opencontainers.image.documentation="https://github.com/snugmo/inglenook" \
      org.opencontainers.image.source="https://github.com/snugmo/inglenook.git" \
      org.opencontainers.image.ref.name="inglenook" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="registry.fedoraproject.org/fedora-bootc:46"

# Account & access. Default login account (UID 1000, shared with the cote
# workspace images). The agent pubkey is baked in at build time via
# --build-arg SSH_PUBKEY=… (empty by default). SSH host keys are generated
# on first sshd run; the ssh-over-vsock listener is generated at boot by
# systemd-ssh-generator when a vsock device is present.
ARG SSH_PUBKEY=
RUN useradd -m -u 1000 -s /bin/bash user \
 && mkdir -p /home/user/.ssh \
 && echo "$SSH_PUBKEY" > /home/user/.ssh/authorized_keys \
 && chown -R user:user /home/user/.ssh \
 && chmod 700 /home/user/.ssh \
 && chmod 600 /home/user/.ssh/authorized_keys

# Boot configuration. Ensure every regenerated initramfs carries the
# virtio-vsock stack so ssh-over-vsock works with no IP in the guest.
# No serial-getty enablement is needed: systemd-getty-generator links a
# serial-getty for each console= on the kernel command line (set in the UKI).
RUN mkdir -p /etc/dracut.conf.d \
 && printf 'kmods+="vmw_vsock_virtio_transport"\n' > /etc/dracut.conf.d/99-vsock.conf
