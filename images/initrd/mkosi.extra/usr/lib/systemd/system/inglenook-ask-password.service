[Unit]
Description=Initrd ask-password agent (prompts for the TPM PIN and other secrets on the console)
Documentation=man:systemd-tty-ask-password-agent(1)
DefaultDependencies=no
# The initrd only: the main system has its own ask-password setup (and no
# console to prompt on until a session is up), so this stops at switch-root.
ConditionPathExists=/etc/initrd-release
Conflicts=initrd-switch-root.target
Before=initrd-switch-root.target

[Service]
# A long-running watcher: it creates /run/systemd/ask-password and serves any
# ask-password request that lands there (a TPM PIN-bound volume's get_pin when
# no cryptsetup.tpm2-pin credential was handed to the boot, a FIDO2 PIN, ...).
# With a credential present it is never invoked, so it is inert on boots that
# pass their secrets that way.
Type=notify
ExecStart=/usr/bin/systemd-tty-ask-password-agent --watch --console
SystemCallArchitectures=native
