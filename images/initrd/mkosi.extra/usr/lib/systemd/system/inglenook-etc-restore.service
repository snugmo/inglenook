[Unit]
Description=Restore /etc from the factory copy if it was wiped
DefaultDependencies=no
ConditionPathExists=/etc/initrd-release
# Either no SELinux config, or an empty /etc.
ConditionPathExists=|!/sysroot/etc/selinux/config
ConditionDirectoryNotEmpty=|!/sysroot/etc
After=bootc-root-setup.service
Before=initrd-root-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# PID 1 loads the SELinux policy from /etc/selinux right after switch-root, and
# early services (udev, hwdb, journald) read /etc before tmpfiles.d in the real
# root has run, so the whole of /etc has to be back before then. The rules
# (C! /etc/<entry>, generated from /usr/share/factory/etc by the Containerfile)
# live in the image. Files written here are unlabeled until setfiles labels them.
ExecStart=systemd-tmpfiles --root=/sysroot --create --boot --prefix=/etc
# Label the restored files from the policy and file contexts in the target tree:
# -r strips the /sysroot prefix so paths match as /etc/..., -c validates the
# contexts against that policy file rather than the (not yet loaded) kernel
# policy, -m keeps setfiles from skipping mounts that do not show seclabel yet,
# which is probably what made an earlier plain `setfiles` a silent no-op here.
ExecStart=sh -c 'setfiles -m -F -r /sysroot -c /sysroot/etc/selinux/targeted/policy/policy.* /sysroot/etc/selinux/targeted/contexts/files/file_contexts /sysroot/etc'
