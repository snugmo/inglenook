[Unit]
Description=First-boot safety net: make the XFS /var partition in the free space after the root
DefaultDependencies=no
ConditionKernelCommandLine=inglenook.var=xfs
ConditionPathExists=/etc/initrd-release
# No TPM condition here: the wrapper picks the definition (sealed to the TPM
# when there is one, empty key slot otherwise), so the no-TPM path makes a
# LUKS volume too instead of skipping. After=tpm2.target and no Wants=:
# systemd-tpm2-generator hooks the target in only when firmware reports a TPM
# whose device is not there yet, so this waits for a slow driver and is a
# no-op on a machine without a TPM.
After=tpm2.target
After=sysroot.mount
Requires=sysroot.mount
Before=bootc-root-setup.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The definitions are kept out of /usr/lib/repart.d on purpose: files there
# make the stock systemd-repart.service run in the initrd, where it fails.
# Idempotent: on a fresh install the installer already made the partition, so
# repart finds nothing to do. When it does create one, it works on the disk
# that backs /sysroot, which is still the plain root filesystem at this point
# (bootc-root-setup has not run).
# A failure (no free space) leaves /var on the root and is logged, not fatal.
ExecStart=-/usr/lib/inglenook/var-repart
