[Unit]
Description=Create the XFS /var partition in the free space after the root
DefaultDependencies=no
ConditionKernelCommandLine=inglenook.var=xfs
# Not on a live stick, whose /var is RAM and whose disk must stay untouched; the
# flag in the UKI is for the system the stick installs.
ConditionKernelCommandLine=!inglenook.live
ConditionPathExists=/etc/initrd-release
# Without a TPM there is nothing to seal the volume to: skip cleanly (/var stays on the
# root) instead of failing. After=tpm2.target and no Wants=: systemd-tpm2-generator hooks
# the target in only when firmware reports a TPM whose device is not there yet, so this
# waits for a slow driver and is a no-op on a machine without a TPM.
ConditionPathExists=/dev/tpmrm0
After=tpm2.target
After=sysroot.mount
Requires=sysroot.mount
Before=bootc-root-setup.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The definition is kept out of /usr/lib/repart.d on purpose: files there make
# the stock systemd-repart.service run in the initrd, where it fails.
# Idempotent: with the partition already there repart finds nothing to do. It
# works on the disk that backs /sysroot, which is still the plain ext4 root at
# this point (bootc-root-setup has not run).
# A failure (no TPM, no free space) leaves /var on the root and is logged, not fatal.
ExecStart=-systemd-repart --dry-run=no --root=/sysroot --definitions=/usr/lib/inglenook/repart.d --no-pager
