[Unit]
Description=Unlock the encrypted XFS /var and mount it over the state directory bootc binds there
DefaultDependencies=no
ConditionKernelCommandLine=inglenook.var=xfs
ConditionPathExists=/etc/initrd-release
# No TPM condition: the volume can also be opened with a FIDO2 token.
After=tpm2.target
After=inglenook-var-repart.service bootc-root-setup.service
Before=initrd-root-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# A service rather than a sysroot-var.mount unit: systemd tracks the bind mount
# bootc already made at /sysroot/var, and skips a mount unit for that path.
# The script also labels a not-yet-relabelled /var from the target tree's
# contexts (see the script: no policy is loaded in the initrd, so the labels
# the first boot's files inherit have to be set before switch-root).
ExecStart=/usr/lib/inglenook/var-mount
