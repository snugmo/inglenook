#!/bin/bash
# inglenook-install: the guided install of Inglenook onto a local disk, from the
# installer stick. It runs as root in the installer initrd (nothing is mounted
# from the stick except while the image is read from it).
#
# Steps: find the image on the stick, pick the disk (shown in full, wiped only
# after a clear confirmation), generate the machine id that identifies the new
# system, partition the disk with systemd-repart seeded by that id (ESP, root of
# the chosen size, /var on LUKS with XFS in all remaining space), and use /var
# itself as the scratch space: open it, copy the image off the stick, let go of
# the stick, `bootc install` into the root, write the machine id into the new
# system, and clean /var again so it starts empty. Everything the installed
# system needs is done here, on the first boot it just boots.
#
# The two image variants differ in how a disk without a TPM is encrypted:
# the tpm2 variant (the default) leaves the root unencrypted, and the no-tpm
# variant makes it a LUKS2 volume with an empty key slot that unlocks
# hands-off and can receive a FIDO2 token later. /var is LUKS2 either way:
# sealed to the machine's TPM when there is one, empty slot otherwise.
#
# Questions are skipped when their answer is in the environment (the tests do
# that): INSTALL_DISK, INSTALL_ROOT_SIZE (50G), INSTALL_ENCRYPT (tpm2|none on
# the tpm2 variant, luks|none on the no-tpm variant),
# INSTALL_RECOVERY_KEY (1|0), INSTALL_CONSOLE (1|0: a serial console on the
# installed system: the stick's UKI addon, copied to the system's ESP),
# INSTALL_TOKEN (1|0: enrol a FIDO2 key for the first user at the first boot), INSTALL_USER / INSTALL_REALNAME / INSTALL_USER_PASSWORD
# (the first user; INSTALL_NO_USER=1 skips it), INSTALL_YES=1 (assume yes everywhere,
# including the wipe), INSTALL_NO_REBOOT=1, INSTALL_TARGET_IMGREF, INSTALL_IMAGE_DIR.
set -Eeuo pipefail
# any command that fails unexpectedly says where, with the ERROR: prefix the tests and users look for
trap 'rc=$?; printf "\nERROR: the installer stopped at line %s (exit status %s): %s\n" "$LINENO" "$rc" "$BASH_COMMAND" >&2' ERR

IN=/usr/installer
RUN=/run/inglenook-install
ESP_SIZE=1G
DEFAULT_ROOT=50G
MIN_ROOT_GIB=8
MIN_VAR_GIB=2
mkdir -p "$RUN"

say()  { printf '\n==> %s\n' "$*"; }
warn() { printf '\nWARNING: %s\n' "$*" >&2; }
die()  { printf '\nERROR: %s\n' "$*" >&2; exit 1; }
# ask VAR "question" [default]: leaves VAR alone when it is already set.
ask() {
  local var=$1 prompt=$2 def=${3:-} reply
  [ -n "${!var:-}" ] && return 0
  read -r -p "$prompt${def:+ [$def]}: " reply || die "no answer (end of input)"
  printf -v "$var" '%s' "${reply:-$def}"
}
yes_no() { # yes_no "question" default(y|n): 0 for yes
  local reply def=$2
  [ -n "${INSTALL_YES:-}" ] && return 0
  read -r -p "$1 [$( [ "$def" = y ] && echo Y/n || echo y/N )]: " reply || die "no answer (end of input)"
  reply=${reply:-$def}
  [[ $reply == [Yy]* ]]
}
gib() { echo $(( $1 / 1073741824 )); }

[ "$(id -u)" = 0 ] || die "run as root"

# The image variant the stick was built from: the no-tpm variant's UKI carries a
# marker in its own initrd, the tpm2 variant's does not.
VARIANT=tpm2
[ -f "$IN/variant" ] && VARIANT=$(cat "$IN/variant")
[ "$VARIANT" = tpm2 ] || [ "$VARIANT" = no-tpm ] || die "Unknown image variant '$VARIANT' (the marker in $IN/variant)."

# --- 1. The image on the stick -------------------------------------------------
find_image() {
  [ -n "${INSTALL_IMAGE_DIR:-}" ] && { SRC=$INSTALL_IMAGE_DIR; SRCDEV=; return 0; }
  local dev n=0 mnt
  for dev in $(lsblk -rpno PATH,FSTYPE | awk '$2 == "vfat" { print $1 }'); do
    mnt=$RUN/src$((n++)); mkdir -p "$mnt"
    mount -o ro "$dev" "$mnt" 2>/dev/null || continue
    if [ -f "$mnt/inglenook/image.oci.tar.000" ]; then SRC=$mnt; SRCDEV=$dev; return 0; fi
    umount "$mnt"
  done
  return 1
}
say "Looking for the Inglenook image (a vfat volume with /inglenook/image.oci.tar.000)"
for _ in $(seq 30); do find_image && break; sleep 1; done
[ -n "${SRC:-}" ] || die "No Inglenook image found. Plug in the installer stick, or a FAT32 drive holding /inglenook/."
IMG=$SRC/inglenook
echo "    found on ${SRCDEV:-$SRC}"
[ -f "$IMG/SHA256SUMS" ] || die "$IMG/SHA256SUMS is missing; refusing to install an unverified image."
echo "    checking the image against SHA256SUMS ..."
(cd "$IMG" && sha256sum --quiet -c SHA256SUMS) || die "The image does not match SHA256SUMS: a damaged copy? Not installing."
TARGET_IMGREF=${INSTALL_TARGET_IMGREF:-$(cat "$IMG/target-imgref" 2>/dev/null || true)}
[ -n "$TARGET_IMGREF" ] || die "No target image reference (set INSTALL_TARGET_IMGREF or provide $IMG/target-imgref)."
echo "    updates will come from: $TARGET_IMGREF"
IMG_BYTES=$(cat "$IMG"/image.oci.tar.* | wc -c)
# the extracted layout plus bootc's temporary files: /var doubles as this scratch space,
# so /var must be at least this big
SCRATCH_GIB=$(( (IMG_BYTES * 3 / 2) / 1073741824 + 2 ))
SRC_DISK=
[ -n "${SRCDEV:-}" ] && SRC_DISK=/dev/$(lsblk -no PKNAME "$SRCDEV" | head -1)

# --- 2. The disk -----------------------------------------------------------------
if [ -z "${INSTALL_DISK:-}" ]; then
  say "Disks in this machine"
  mapfile -t disks < <(lsblk -dpno PATH,TYPE,RO | awk '$2 == "disk" && $3 == 0 { print $1 }' | grep -vE '^/dev/(zram|loop|ram)' | grep -vxF "${SRC_DISK:-none}" || true)
  [ ${#disks[@]} -gt 0 ] || die "No disk to install to (the installer stick is excluded)."
  i=0; for d in "${disks[@]}"; do i=$((i+1)); printf '  %d) %s\n' "$i" "$(lsblk -dno PATH,SIZE,TRAN,MODEL "$d")"; done
  ask INSTALL_DISK "Install to which disk? (number or /dev/... path)" "$([ ${#disks[@]} = 1 ] && echo 1)"
  if [[ $INSTALL_DISK =~ ^[0-9]+$ ]]; then INSTALL_DISK=${disks[$((INSTALL_DISK-1))]:-}; fi
fi
DISK=$INSTALL_DISK
[ -b "$DISK" ] && [ "$(lsblk -dno TYPE "$DISK")" = disk ] || die "$DISK is not a disk."
[ "$DISK" != "$SRC_DISK" ] || die "$DISK is the disk the image is read from."
lsblk -rno MOUNTPOINTS "$DISK" | grep -q . && die "$DISK has mounted filesystems; it is in use."
DISK_BYTES=$(blockdev --getsize64 "$DISK")

# --- 3. What is on it, and the confirmation ---------------------------------------------
say "This is what is on $DISK now"
lsblk -o NAME,SIZE,FSTYPE,LABEL,PARTLABEL "$DISK" | sed 's/^/    /'
parts=$(lsblk -rno TYPE "$DISK" | grep -c '^part' || true)
sigs=$(wipefs -n "$DISK" 2>/dev/null | tail -n +2 || true)
fstypes=$(lsblk -rno FSTYPE "$DISK" | sort -u | grep . | tr '\n' ' ' || true)
if [ "$parts" = 0 ] && [ -z "$sigs" ] && [ -z "$fstypes" ]; then
  echo "    The disk looks empty."
  EMPTY=1
else
  EMPTY=0
  echo "    $parts partition(s); filesystems and signatures: ${fstypes:-none}"
  case " $fstypes " in *" ntfs "*|*" BitLocker "*) echo "    -> looks like Windows data";; esac
  case " $fstypes " in *" crypto_LUKS "*) echo "    -> contains LUKS-encrypted volumes (an encrypted Linux install?)";; esac
  lsblk -rno PARTLABEL "$DISK" | grep -qx root && echo "    -> has a partition labeled 'root': possibly an earlier Inglenook install"
fi
printf '\n  *** EVERYTHING ON %s WILL BE ERASED. This cannot be undone. ***\n' "$DISK"
if [ "$EMPTY" = 1 ]; then
  yes_no "Install Inglenook to $DISK?" n || die "Cancelled; nothing was changed."
elif [ -n "${INSTALL_YES:-}" ]; then
  :
else
  read -r -p "To erase it, type the device name ($DISK): " reply || die "no answer (end of input)"
  [ "$reply" = "$DISK" ] || die "Not confirmed; nothing was changed."
fi

# --- 4. Sizes ---------------------------------------------------------------------------------
esp_gib=$(numfmt --from=iec --to-unit=1073741824 "$ESP_SIZE")
# /var takes all the space after the root, and it also holds the image while it is
# being copied off the stick, so it must fit the scratch: the most the root can
# have leaves that much (plus a GiB of alignment slack) for /var.
var_min_gib=$(( SCRATCH_GIB > MIN_VAR_GIB ? SCRATCH_GIB : MIN_VAR_GIB ))
max_root_gib=$(( $(gib "$DISK_BYTES") - esp_gib - var_min_gib - 1 ))
[ "$max_root_gib" -ge "$MIN_ROOT_GIB" ] || die "$DISK is too small: it needs about $((MIN_ROOT_GIB + esp_gib + var_min_gib + 1)) GiB."
def_root=$DEFAULT_ROOT
[ "$(numfmt --from=iec --to-unit=1073741824 "$def_root")" -le "$max_root_gib" ] || def_root=${max_root_gib}G
echo
echo "The root filesystem holds the system image and its state. Everything else on the disk"
echo "becomes /var (XFS on an encrypted volume, created now); $max_root_gib GiB is the most the root can have here."
ask INSTALL_ROOT_SIZE "Size of the root" "$def_root"
ROOT_BYTES=$(numfmt --from=iec "$INSTALL_ROOT_SIZE" 2>/dev/null) || die "'$INSTALL_ROOT_SIZE' is not a size (examples: 50G, 64G)."
root_gib=$(gib "$ROOT_BYTES")
[ "$root_gib" -ge "$MIN_ROOT_GIB" ] && [ "$root_gib" -le "$max_root_gib" ] || die "The root must be between ${MIN_ROOT_GIB}G and ${max_root_gib}G."

# --- 5. Encryption ------------------------------------------------------------------------------
if [ -z "${INSTALL_ENCRYPT:-}" ]; then
  if [ "$VARIANT" = no-tpm ]; then
    # This image is built to boot without a TPM: the root is a LUKS2 volume with an
    # empty key (a FIDO2 token or a recovery key can be enrolled later), never
    # sealed to the TPM even when there is one.
    [ -c /dev/tpmrm0 ] && echo "    This is the no-TPM image: a TPM, if there is one, is not used. Use the tpm2 image for a TPM-sealed disk."
    INSTALL_ENCRYPT=luks
  elif [ -c /dev/tpmrm0 ]; then
    yes_no "Encrypt the disk, unlocked by this machine's TPM (recommended)?" y && INSTALL_ENCRYPT=tpm2 || INSTALL_ENCRYPT=none
  else
    warn "No TPM 2.0 found: the disk cannot be sealed to this machine."
    yes_no "Install WITHOUT disk encryption?" n || die "Cancelled; nothing was changed."
    INSTALL_ENCRYPT=none
  fi
fi
# root_encrypt: how the root partition is made (repart's Encrypt=); var_encrypt: the same
# for /var, which is encrypted whatever the root is (tpm2 when there is a TPM to seal to,
# an empty key slot otherwise - it unlocks with the empty password until a FIDO2 token
# or a recovery key is enrolled).
case "$INSTALL_ENCRYPT" in
  tpm2)
    [ "$VARIANT" = tpm2 ] || die "The $VARIANT image does not seal to the TPM (INSTALL_ENCRYPT is luks or none)."
    [ -c /dev/tpmrm0 ] || die "TPM encryption was asked for, but there is no /dev/tpmrm0."
    root_encrypt=tpm2 var_encrypt=tpm2
    ;;
  luks)
    [ "$VARIANT" = no-tpm ] || die "TPM-less LUKS (INSTALL_ENCRYPT=luks) is only on the no-tpm image."
    root_encrypt=key-file var_encrypt=key-file
    ;;
  none)
    root_encrypt=
    [ -c /dev/tpmrm0 ] && var_encrypt=tpm2 || var_encrypt=key-file
    ;;
  *) die "'$INSTALL_ENCRYPT' is not an encryption mode ($([ "$VARIANT" = tpm2 ] && echo 'tpm2, none' || echo 'luks, none'))." ;;
esac
if [ -n "$root_encrypt" ]; then
  case $root_encrypt in
    tpm2) root_desc='LUKS2, key sealed to the TPM';;
    key-file) root_desc='LUKS2, empty key (a FIDO2 token can be enrolled later)';;
  esac
fi
RECOVERY=
if [ "$INSTALL_ENCRYPT" = tpm2 ] && [ -z "${INSTALL_RECOVERY_KEY:-}" ]; then
  yes_no "Create a recovery key (needed if the TPM is ever cleared or the board replaced)?" y && INSTALL_RECOVERY_KEY=1 || INSTALL_RECOVERY_KEY=0
fi

# --- 5b. The first user ----------------------------------------------------------------------------
FIRST_USER=
if [ -z "${INSTALL_NO_USER:-}" ]; then
  if [ -z "${INSTALL_USER:-}" ] && [ -n "${INSTALL_YES:-}" ]; then
    warn "No INSTALL_USER given: the first boot will ask for the first user on the console."
  elif [ -z "${INSTALL_USER:-}" ]; then
    echo
    echo "Nobody can log in to the new system yet: root is locked and there is no other account."
    if yes_no "Create the first user (a systemd-homed account that may use run0) now?" y; then
      ask INSTALL_USER "Username"
    else
      echo "    Skipped: the first boot will ask for it on the console (systemd-homed-firstboot)."
    fi
  fi
  if [ -n "${INSTALL_USER:-}" ]; then
    FIRST_USER=$INSTALL_USER
    [[ $FIRST_USER =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] || die "'$FIRST_USER' is not a usable username (lowercase letters, digits, - and _; at most 31)."
    case $FIRST_USER in root|nobody) die "'$FIRST_USER' is reserved."; esac
    # Names the image has as users or groups (the stick's accounts file): a homed account
    # with one of them would be refused at the first boot, after the install.
    if [ -f "$IMG/accounts" ] && grep -qxF -- "$FIRST_USER" "$IMG/accounts"; then
      die "'$FIRST_USER' is already a user or group of the system. Choose another name."
    fi
    if [ -z "${INSTALL_YES:-}" ]; then ask INSTALL_REALNAME "Full name (optional)" ""; fi
    FIRST_REAL=${INSTALL_REALNAME:-}
    FIRST_PW=${INSTALL_USER_PASSWORD:-}
    while [ -z "$FIRST_PW" ]; do
      read -rsp "Password for $FIRST_USER: " FIRST_PW || die "no answer (end of input)"; echo
      read -rsp "Password again: " pw2 || die "no answer (end of input)"; echo
      if [ "$FIRST_PW" != "$pw2" ] || [ "${#FIRST_PW}" -lt 8 ]; then
        echo "    The two differ, or are shorter than 8 characters. Try again."; FIRST_PW=
      fi
    done
    FIRST_TOKEN=0
    if [ -n "${INSTALL_TOKEN:-}" ]; then FIRST_TOKEN=$INSTALL_TOKEN
    elif [ -z "${INSTALL_YES:-}" ]; then
      echo
      echo "A FIDO2 security key (YubiKey ...) can unlock $FIRST_USER's account instead of the password."
      echo "The first boot then asks you to insert it and to enter its PIN (set one beforehand);"
      echo "the password keeps working too."
      yes_no "Enrol a security key for $FIRST_USER at the first boot?" n && FIRST_TOKEN=1
    fi
  fi
fi

# --- 5c. The serial console ------------------------------------------------------------------------
# The image's UKI carries no console= argument: on a machine without a UART it
# would start a serial getty that fails and restarts every 10 seconds, so it
# cannot be baked in. A locked-down (Secure Boot, type-2) UKI accepts no other
# kernel arguments either, so the only way to give the system a serial console
# is a UKI addon on its ESP: the stub appends the addon's cmdline to the
# UKI's. The stick carries one (console=tty0 console=ttyS0,115200n8); on
# request it is copied to the installed ESP. console= only selects which
# consoles are shown and grants no privilege, which is why it is the only
# argument the addon carries.
CONSOLE_ADDON=
if [ -f "$SRC/loader/addons/serial-console.addon.efi" ]; then
  CONSOLE_ADDON=$SRC/loader/addons/serial-console.addon.efi
  if [ -z "${INSTALL_CONSOLE:-}" ]; then
    yes_no "Give the installed system a serial console (a UKI addon on its ESP; useful for headless machines)?" n && INSTALL_CONSOLE=1 || INSTALL_CONSOLE=0
  fi
  if [ "${INSTALL_CONSOLE:-0}" = 1 ] && [ -z "${INSTALL_YES:-}" ]; then
    echo "    The addon adds 'console=tty0 console=ttyS0,115200n8' to the kernel command line; remove loader/addons/serial-console.addon.efi from the ESP to turn it off."
  fi
else
  [ -z "${INSTALL_CONSOLE:-}" ] || warn "INSTALL_CONSOLE is set, but this stick has no serial-console addon (an older stick?): the installed system will have no serial console."
  INSTALL_CONSOLE=0
fi

# --- 6. Wipe and partition ------------------------------------------------------------------------
say "Erasing $DISK"
for p in $(lsblk -rpno PATH,TYPE "$DISK" | awk '$2 == "part" { print $1 }'); do wipefs -a -q "$p" || true; done
sgdisk -Z -q "$DISK" >/dev/null 2>&1 || true
wipefs -a -q "$DISK"
udevadm settle

# The machine id: generated here, before the partitions exist. It seeds
# systemd-repart, which derives every partition, LUKS and filesystem UUID from
# it (HMAC-SHA256), so the layout is a stable function of the machine's
# identity, and it becomes the new system's /etc/machine-id (written in step 8).
# It must not be null: repart would then seed with a random id, and the
# first-boot initrd (reading a not-yet-set /etc/machine-id) would derive
# different UUIDs and refuse the existing layout.
MACHINE_ID=$(uuidgen | tr -d '-' | tr 'A-F' 'a-f')
say "Partitioning: ESP $ESP_SIZE, root ${root_gib}G${root_desc:+ ($root_desc)}, /var the rest ($([ "$var_encrypt" = tpm2 ] && echo 'XFS on LUKS2, sealed to the TPM' || echo 'XFS on LUKS2, empty key'))"
rm -rf "$RUN/repart.d"; mkdir -p "$RUN/repart.d"
cp "$IN"/repart.d/*.conf "$RUN/repart.d/"
# The committed definitions carry the shape of the partitions; systemd-repart's config
# files take no run-time values (and the root cannot use a SupplementFor= file, which
# is forbidden together with its Encrypt=tpm2), so what the installer knows now is
# appended to the copies: the chosen root size, and the LUKS2 encryption of the root
# and of /var.
{
  printf 'SizeMinBytes=%s\nSizeMaxBytes=%s\n' "$ROOT_BYTES" "$ROOT_BYTES"
  [ -n "$root_encrypt" ] && printf 'Encrypt=%s\n' "$root_encrypt"
} >> "$RUN/repart.d/10-root.conf"
printf 'Encrypt=%s\n' "$var_encrypt" >> "$RUN/repart.d/60-var.conf"
# --seed: derive all partition UUIDs (and the LUKS2 and filesystem UUIDs they
# seed in turn) from the machine id, so the disk is a deterministic function of
# the machine (repart's machine-id default would not work: the installer's
# /sysroot has no machine id yet). --tpm2-public-key-pcrs= (empty): do not bind
# the volumes to the UKI's signed PCR 11 key, which systemd-repart would
# otherwise pick up from /run/systemd.
# --copy-source=/ resolves the definitions' CopyFiles= sources (the ESP's
# fwupdx64.efi) against the installer's own root: in the initrd repart would
# default to /sysroot, which is empty here.
SYSTEMD_REPART_MKFS_OPTIONS_EXT4='-O verity' systemd-repart --tpm2-public-key-pcrs= --copy-source=/ \
  --seed="$MACHINE_ID" --empty=require --dry-run=no --pretty=no --definitions="$RUN/repart.d" "$DISK" >/dev/null
udevadm settle
for l in ESP root var; do for _ in $(seq 20); do [ -e "/dev/disk/by-partlabel/$l" ] && break; sleep 0.5; done; done
[ -e /dev/disk/by-partlabel/ESP ] && [ -e /dev/disk/by-partlabel/root ] && [ -e /dev/disk/by-partlabel/var ] \
  || die "A partition (ESP, root or var) did not appear after repartitioning."
ROOTPART=/dev/disk/by-partlabel/root
rootdev=$ROOTPART
case "$INSTALL_ENCRYPT" in
  tpm2)
    systemd-cryptsetup attach root "$ROOTPART" - tpm2-device=auto,headless=yes
    rootdev=/dev/mapper/root
    if [ "${INSTALL_RECOVERY_KEY:-0}" = 1 ]; then
      RECOVERY=$(systemd-cryptenroll --recovery-key --unlock-tpm2-device=auto "$ROOTPART" | tail -1)
      printf '\n  RECOVERY KEY (write it down, it is shown again at the end):\n\n      %s\n\n' "$RECOVERY"
    fi
    ;;
  luks)
    # no key material anywhere: the empty key slot answers the empty password
    systemd-cryptsetup attach root "$ROOTPART" - try-empty-password=true
    rootdev=/dev/mapper/root
    ;;
esac
# /var is the scratch: its XFS holds the image and bootc's working files until
# the install is done, then it is cleaned and starts as an empty /var.
case "$var_encrypt" in
  tpm2)    systemd-cryptsetup attach var /dev/disk/by-partlabel/var - tpm2-device=auto,headless=yes ;;
  key-file) systemd-cryptsetup attach var /dev/disk/by-partlabel/var - try-empty-password=true ;;
esac
mkdir -p /target /scratch
mount "$rootdev" /target
mkdir -p /target/boot && mount /dev/disk/by-partlabel/ESP /target/boot
mount /dev/mapper/var /scratch

# --- 7. Copy the image off the stick -----------------------------------------------------------------
say "Copying the image from the stick (about $(( IMG_BYTES / 1048576 )) MiB, into /var)"
mkdir -p /scratch/oci /scratch/tmp
cat "$IMG"/image.oci.tar.* | tar -x -C /scratch/oci
# bootc reads the running root's ostree config the way it reads a container's; take the
# image's own, shipped on the stick next to it.
mkdir -p /etc/ostree
if [ -f "$IMG/prepare-root.conf" ]; then cp "$IMG/prepare-root.conf" /etc/ostree/prepare-root.conf
else printf '[composefs]\nenabled = yes\n[sysroot]\nreadonly = true\n' > /etc/ostree/prepare-root.conf; fi
# The serial-console addon (step 5c) is staged from the stick now, because the
# stick is let go before the installed ESP is written.
[ "${INSTALL_CONSOLE:-0}" = 1 ] && [ -n "$CONSOLE_ADDON" ] && cp "$CONSOLE_ADDON" "$RUN/serial-console.addon.efi"
for m in "$RUN"/src*; do mountpoint -q "$m" 2>/dev/null && umount "$m"; done
say "The USB stick is no longer needed: you can unplug it now."

# --- 8. Install ------------------------------------------------------------------------------------------
say "Installing (bootc, composefs, systemd-boot)"
mount --bind /scratch/tmp /var/tmp
bootc install to-filesystem --composefs-backend --bootloader systemd --generic-image \
  --skip-fetch-check --source-imgref oci:/scratch/oci:latest --target-imgref "$TARGET_IMGREF" /target
deploys=(/target/state/deploy/*/)
[ ${#deploys[@]} = 1 ] && [ -d "${deploys[0]}etc" ] || die "Cannot find the deployment's /etc under /target/state/deploy."
DEPLOY=${deploys[0]%/}
# bootc finalized the target (fstrim, then mounted it read-only)
mount -o remount,rw /target

# The serial console (step 5c): the addon on the installed ESP. It is written
# after bootc, so the boot files bootc just laid down are there first, and the
# addon is an addition the stub picks up, not a rewrite of the UKI.
if [ "${INSTALL_CONSOLE:-0}" = 1 ]; then
  mkdir -p /target/boot/loader/addons
  cp "$RUN/serial-console.addon.efi" /target/boot/loader/addons/
  echo "    serial console: on the installed ESP (loader/addons/serial-console.addon.efi)"
fi

# The machine id of the new system: the same one that seeded the partition
# UUIDs (step 6). It goes into the deployment's /etc (what the first boot's
# initrd conditions and the deployment activation read) and into the top-level
# /etc on the root if bootc left one there. Once set, the first boot is not a
# first boot anymore: no machine id commit, no disk-encryption wizard - the
# volumes already exist and their keys were decided here.
say "Writing the machine id $MACHINE_ID"
for f in "$DEPLOY/etc/machine-id" /target/etc/machine-id; do
  [ -d "$(dirname "$f")" ] || continue
  [ -e "$f" ] || : > "$f"
  chmod u+w "$f" 2>/dev/null || true
  printf '%s\n' "$MACHINE_ID" > "$f"
  chmod 0444 "$f"
done

# The first user: a home.create.<name> credential in the new system's /etc/credstore (on the
# encrypted root, readable by root only). systemd-homed-firstboot creates the account from it
# on the first boot and the drop-in in the image deletes the file again. The record holds the
# password hash, and the password itself in "secret" (homed needs it to create the home).
if [ -n "$FIRST_USER" ]; then
  say "Leaving a credential for the first user '$FIRST_USER'"
  # the root is encrypted as a whole: a plain directory home; otherwise homed's default (LUKS)
  storage=; [ -n "$root_encrypt" ] && storage=directory
  # perMachine: [] is not decoration: without the field, `homectl update --fido2-device=` on this record
  # (the first-boot token enrolment) fails with "Object field 'perMachine' has wrong type null".
  hash=$(printf '%s' "$FIRST_PW" | openssl passwd -6 -stdin)
  mkdir -p -m 0700 "$DEPLOY/etc/credstore"
  ( umask 077
    jq -n --arg u "$FIRST_USER" --arg r "$FIRST_REAL" --arg h "$hash" --arg p "$FIRST_PW" --arg s "$storage" \
      '{userName: $u, memberOf: ["wheel"], shell: "/bin/bash", perMachine: [], privileged: {hashedPassword: [$h]}, secret: {password: [$p]}}
       + (if $r != "" then {realName: $r} else {} end) + (if $s != "" then {storage: $s} else {} end)' \
      > "$DEPLOY/etc/credstore/home.create.$FIRST_USER" )
  [ -s "$DEPLOY/etc/credstore/home.create.$FIRST_USER" ] || die "Could not write the first user's credential."
  # Rootless podman and buildah need subordinate id ranges; a homed account gets none by itself.
  for f in subuid subgid; do printf '%s:524288:65536\n' "$FIRST_USER" >> "$DEPLOY/etc/$f"; done
  if [ "${FIRST_TOKEN:-0}" = 1 ]; then
    mkdir -p "$DEPLOY/etc/inglenook"; printf '%s\n' "$FIRST_USER" > "$DEPLOY/etc/inglenook/enroll-token"
  fi
  # label them like the initrd's etc-restore does: strip the deployment prefix so the path matches /etc/...
  setfiles -m -F -r "$DEPLOY" -c "$DEPLOY"/etc/selinux/targeted/policy/policy.* \
    "$DEPLOY/etc/selinux/targeted/contexts/files/file_contexts" "$DEPLOY/etc/machine-id" "$DEPLOY/etc/credstore" "$DEPLOY/etc/subuid" "$DEPLOY/etc/subgid" \
    $([ -d "$DEPLOY/etc/inglenook" ] && echo "$DEPLOY/etc/inglenook") \
    || warn "Could not label the credential; the first boot may log SELinux denials."
  echo "    credential: $(ls -ldZ "$DEPLOY/etc/credstore/home.create.$FIRST_USER" | cut -c1-120)"
  [ -n "$root_encrypt" ] || warn "The disk is not encrypted: the password sits in /etc/credstore until the first boot deletes it."
fi
if [ -d /sys/firmware/efi/efivars ] && command -v efibootmgr >/dev/null; then
  efibootmgr --quiet --create --disk "$DISK" --part 1 --label Inglenook --loader '\EFI\systemd\systemd-bootx64.efi' \
    || warn "Could not add a boot menu entry; the firmware will use the fallback path (\\EFI\\BOOT\\BOOTX64.EFI)."
fi

# --- 9. Tidy up ------------------------------------------------------------------------------------------------
say "Finishing"
umount /var/tmp
# /var is about to leave: take the image and the working files with it
rm -rf /scratch/oci /scratch/tmp
umount /scratch
case "$var_encrypt" in tpm2|key-file) cryptsetup close var ;; esac
umount /target/boot /target
[ -n "$root_encrypt" ] && cryptsetup close root
sync
say "Installation complete."
if [ -n "$RECOVERY" ]; then
  printf '\n  RECOVERY KEY for the encrypted root: %s\n  Keep it somewhere safe and off this machine.\n' "$RECOVERY"
fi
echo
if [ -n "$FIRST_USER" ]; then
  echo "  Log in as '$FIRST_USER' after the first boot; use run0 for administrative tasks."
else
  echo "  The first boot asks for the first user on the console; without one nobody can log in."
fi
if [ "${INSTALL_CONSOLE:-0}" = 1 ]; then
  echo "  The system has a serial console (the ESP's loader/addons/serial-console.addon.efi);"
  echo "  delete that file to turn it off again."
fi
if [ "$var_encrypt" = tpm2 ]; then
  echo "  To add a recovery key or a FIDO2 token for the /var volume later, use"
  echo "  systemd-cryptenroll (run0) on /dev/disk/by-partlabel/var."
elif [ "$var_encrypt" = key-file ]; then
  echo "  The /var volume has an empty key and unlocks hands-off. To make it need a"
  echo "  FIDO2 token (or a recovery key) instead, enrol one later with systemd-cryptenroll"
  echo "  (run0) on /dev/disk/by-partlabel/var."
fi
if [ -z "${INSTALL_NO_REBOOT:-}" ]; then
  while [ -n "$SRC_DISK" ] && [ -b "$SRC_DISK" ]; do
    read -r -p "Unplug the USB stick, then press Enter to reboot (or type 'ignore'): " reply || break
    [ "$reply" = ignore ] && break
  done
  systemctl reboot
fi
