#!/bin/sh
# The installer's console shell: the banner, then a root shell. One instance
# per console (inglenook-shell.service on the keyboard, inglenook-shell-serial
# on the serial, whenever the machine has a serial port), so the installer
# works whichever terminal the user is on. Not sulogin: with
# SYSTEMD_SULOGIN_FORCE it still prints its "rescue mode" text and waits for
# Enter.
cat /usr/installer/motd
# A serial line is slow and the tty layer drops what is still queued when the
# shell resets the terminal; rewriting the settings waits for the output to drain.
stty "$(stty -g)"
exec /usr/bin/bash
