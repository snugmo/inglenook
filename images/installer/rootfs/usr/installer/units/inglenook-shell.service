[Unit]
Description=Inglenook installer shell (keyboard console)
DefaultDependencies=no
After=basic.target
# a TPM that firmware reports is up before the first prompt (ordering only, no Wants=)
After=tpm2.target
Conflicts=shutdown.target
Before=shutdown.target
# The keyboard console is the installer's basic state: it runs whenever the
# node exists, addon or not. The twin on the serial console is
# inglenook-shell-serial.service.
ConditionPathExists=/dev/tty0

# Like rescue.service, but straight to a root shell with a banner: this is a
# stick that is only ever booted to install, so there is no root password to ask for.
# The unit binds the keyboard console explicitly: /dev/console is the *last*
# console= on the kernel command line, so without TTYPath the shell would sit
# on the serial line as soon as the serial-console addon is on the ESP, and
# the screen would have no shell at all.
[Service]
Environment=HOME=/root
Environment=PATH=/usr/installer/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
WorkingDirectory=-/root
# the banner comes back after every exit of the shell (Restart=always)
ExecStart=/usr/installer/bin/shell
Type=idle
Restart=always
RestartSec=0
StandardInput=tty-force
TTYPath=/dev/tty0
StandardOutput=inherit
StandardError=inherit
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=yes
