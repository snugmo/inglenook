[Unit]
Description=Relabel /etc restored by the initrd
DefaultDependencies=no
ConditionPathExists=/run/inglenook
ConditionSecurity=selinux
# As early as possible: until it has run, the restored files are unlabeled and
# anything that reads them is denied.
Before=sysinit.target systemd-journald.service systemd-udevd.service systemd-hwdb-update.service systemd-tmpfiles-setup.service systemd-sysusers.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/restorecon -R /etc

[Install]
WantedBy=sysinit.target
