; Local SELinux policy for inglenook, installed with `semodule -i` at image build
; time (see the Containerfile). CIL needs no compiler: add `(allow ...)` lines.
; To find what is missing, boot with enforcing=0 (the UKI default while the
; policy is being worked out) and run `ausearch -m avc` as root; denials that a
; dontaudit rule would hide are logged only in a build with
; SELINUX_NO_DONTAUDIT=1 (`semodule -DB`).

; The per-connection sshd that systemd-ssh-generator starts for ssh-over-vsock
; accepts a hypervisor-injected key from the ssh.ephemeral-authorized_keys-all
; credential, which is a file in /run/credentials labeled init_var_run_t.
; Without this, sshd-session is denied (silently, by a dontaudit rule) and the
; key is ignored. Found with a permissive sshd_session_t: these three, nothing
; else. Works for root only: the credential directory is root-only, so sshd,
; which reads it as the target user, cannot use it for other accounts.
(allow sshd_session_t init_var_run_t (file (getattr open read)))

; systemd-homework (the helper systemd-homed spawns to create, mount and
; resize home areas) does an fstatfs-style getattr on the pidfs filesystem.
; Seen when creating LUKS and directory homes on Fedora 45 (selinux-policy
; 45.20); harmless to allow.
(allow systemd_homework_t pidfs_t (filesystem (getattr)))

; run0 authenticates through polkit-agent-helper, which runs as a
; socket-activated service (polkit-agent-helper.socket) instead of a setuid
; binary. The agent hands it the caller's pty, so the helper and the
; unix_chkpwd it runs inherit that terminal. Found by running run0 from an ssh
; session with a pty.
(allow policykit_auth_t user_devpts_t (chr_file (getattr)))
(allow chkpwd_t user_devpts_t (chr_file (read write)))

; tuned-ppd (the PPD-to-TuneD API translation daemon the image installs) writes
; its own log, /var/log/tuned/tuned-ppd.log: the directory and file carry the
; default var_log_t label, and the base policy grants tuned_t that access but
; not tuned_ppd_t (write on the file is already allowed; only the directory
; and the open of the new file were denied).
(allow tuned_ppd_t var_log_t (dir (add_name write)))
(allow tuned_ppd_t var_log_t (file (create open)))

; A login on the console (agetty and login): the PAM account check runs
; unix_chkpwd, which inherits the console tty.
(allow chkpwd_t tty_device_t (chr_file (read write)))

; The same for a login through kmscon (the tty1 console): unix_chkpwd inherits
; kmscon's pty.
(allow chkpwd_t kmscon_devpts_t (chr_file (read write)))

; systemd-pcrextend measures into the TPM (PCRs and NvPCRs): it finds the TPM
; through its udev database entry and lists /run/systemd/nvpcr. Seen on every
; boot of a machine with a TPM. To initialise an NvPCR it also reads the PCR
; public key and signature that systemd-stub's tmpfiles rule copies into
; /run/systemd (tpm2-pcr-public-key.pem, tpm2-pcr-signature.json).
(allow systemd_pcrextend_t udev_var_run_t (file (getattr open read)))
(allow systemd_pcrextend_t init_var_run_t (dir (read)))
(allow systemd_pcrextend_t init_var_run_t (file (getattr open read)))

; While run0 checks the password, polkit-agent-helper writes to the fifo that
; systemd-homed gives out to keep the machine from suspending
; (/run/systemd/home/<user>.dont-suspend).
(allow policykit_auth_t systemd_homed_runtime_pipe_t (fifo_file (write)))

; systemd-homed reads /proc/1/environ (container detection).
(allow systemd_homed_t init_t (dir (search)))
(allow systemd_homed_t init_t (file (getattr ioctl open read)))

; The NetworkManager dispatcher scripts inherit the journal stream socket
; (their stdout and stderr) that PID 1 made. Without this their output is lost.
(allow NetworkManager_dispatcher_chronyc_t init_t (unix_stream_socket (read write)))
(allow NetworkManager_dispatcher_console_t init_t (unix_stream_socket (read write)))
(allow NetworkManager_dispatcher_nvme_t init_t (unix_stream_socket (read write)))

; CAP_NET_ADMIN is asked for, and must not be granted, by processes that size
; a socket buffer (SO_SNDBUFFORCE/SO_RCVBUFFORCE) and fall back to the plain
; option when refused (the log and notify sockets of libsystemd). The stock
; policy only hides this for some domains: these are the others that log it.
(dontaudit gssproxy_t self (capability (net_admin)))
(dontaudit kmscon_t self (capability (net_admin)))
(dontaudit policykit_auth_t self (capability (net_admin)))
(dontaudit system_dbusd_t self (capability (net_admin)))
(dontaudit systemd_hwdb_t self (capability (net_admin)))
(dontaudit systemd_modules_load_t self (capability (net_admin)))
(dontaudit systemd_network_generator_t self (capability (net_admin)))
(dontaudit systemd_pcrextend_t self (capability (net_admin)))
(dontaudit systemd_ssh_issue_t self (capability (net_admin)))
(dontaudit systemd_tmpfiles_t self (capability (net_admin)))
(dontaudit systemd_user_runtimedir_t self (capability (net_admin)))
